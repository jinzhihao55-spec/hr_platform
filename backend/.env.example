# ===== 应用 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== MySQL 8.0+ =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DB=ai_hr_reports
MYSQL_CHARSET=utf8mb4

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 生产/恢复环境必须使用同一密钥，否则跨运行人员身份无法稳定关联。
PERSON_KEY_SECRET=
PERSON_KEY_VERSION=v1

# ===== LLM（阿里云百炼 OpenAI 兼容 API）=====
# 文档: https://help.aliyun.com/zh/model-studio/what-is-model-studio
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus

# TaoToken 旧配置停用；不要把阿里云 API Key 发送给第三方中转。
# LLM_BASE_URL=https://taotoken.net/api/v1
# LLM_MODEL=deepseek-v4-pro

# 视觉模型（图像识别：解析 OA/招聘等图片/截图格式报表；留空则不启用，图片将被拒绝并提示改传 Excel）
# 走阿里云百炼官方接口，使用支持 image_url 的 qwen3.7-plus
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_MODEL=qwen3.7-plus

# TaoToken 旧配置停用：
# LLM_VISION_BASE_URL=https://taotoken.net/api/v1

# LLM 请求边界（秒 / 次，文本与视觉共用；防止一次挂起的调用占住上传接口）
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ===== Skills =====
# Skill 提示词存放于此，单独维护，当前留空。
SKILLS_DIR=./docs/skills

# ===== 存储 =====
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs

# ===== API 守门 =====
# token 为空 = 关闭认证（仅限 dev/local/test）；staging/uat/prod 必须设置
API_AUTH_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20
# 可确认/上传月初基线的网关用户名（逗号分隔）；共享环境留空 = 无人可操作
MONTH_OPENING_ALLOWED_USERS=
