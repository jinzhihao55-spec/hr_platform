# Copy to deploy/.env and fill every blank secret before starting Compose.
# This file intentionally contains variable names only, never usable secrets.

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
OPERATOR_ID=local-hr-operator
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
REPORT_RULE_VERSION=2026-07-23

MYSQL_USER=hr_agent
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=

API_AUTH_TOKEN=
PERSON_KEY_SECRET=
PERSON_KEY_VERSION=v1

LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_MODEL=qwen3.7-plus
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# The default sibling-repository layout needs no overrides. Absolute paths are
# useful when backend/frontend/database are checked out as separate worktrees.
# BACKEND_CONTEXT=/absolute/path/to/backend
# FRONTEND_CONTEXT=/absolute/path/to/frontend
# DATABASE_CONTEXT=/absolute/path/to/database
